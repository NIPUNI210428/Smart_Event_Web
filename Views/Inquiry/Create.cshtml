@model Smart_Event_Web.Models.Inquiry

@{
    ViewData["Title"] = "Contact Council";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="card shadow-lg border-0 rounded-3">
                @* Professional Header reflecting the Council's Branding *@
                <div class="card-header bg-primary text-white text-center py-4">
                    <h3 class="mb-0 fw-bold"><i class="bi bi-chat-dots-fill me-2"></i>Metropolitan Cultural Council</h3>
                    <p class="mb-0 small opacity-75">Guest Inquiry & Support Portal</p>
                </div>

                <div class="card-body p-4 p-lg-5">
                    <p class="text-center text-muted mb-4">
                        Have a question about an event, venue, or membership?
                        Send us a message and our team will get back to you shortly.
                    </p>

                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()

                        <div class="row">
                            @* Full Name Field *@
                            <div class="col-md-6 mb-3">
                                <label asp-for="GuestName" class="form-label fw-bold">Full Name</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-person"></i></span>
                                    <input asp-for="GuestName" class="form-control" placeholder="John Doe" required />
                                </div>
                                <span asp-validation-for="GuestName" class="text-danger small"></span>
                            </div>

                            @* Email Address Field - Vital for Council communication *@
                            <div class="col-md-6 mb-3">
                                <label asp-for="Email" class="form-label fw-bold">Email Address</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-envelope"></i></span>
                                    <input asp-for="Email" type="email" class="form-control" placeholder="john@example.com" required />
                                </div>
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                        </div>

                        @* Subject Field - Categorizes the inquiry in the database *@
                        <div class="mb-3">
                            <label asp-for="Subject" class="form-label fw-bold">Subject</label>
                            <select asp-for="Subject" class="form-select" required>
                                <option value="" disabled selected>Select a topic...</option>
                                <option value="Event Information">Event Information</option>
                                <option value="Membership Inquiry">Membership Inquiry</option>
                                <option value="Technical Support">Technical Support</option>
                                <option value="General Feedback">General Feedback</option>
                            </select>
                            <span asp-validation-for="Subject" class="text-danger small"></span>
                        </div>

                        @* Message Field - Detailed inquiry content *@
                        <div class="mb-4">
                            <label asp-for="Message" class="form-label fw-bold">Your Message</label>
                            <textarea asp-for="Message" class="form-control" rows="5" placeholder="How can we assist you today?" required></textarea>
                            <span asp-validation-for="Message" class="text-danger small"></span>
                        </div>

                        @* Action Buttons with Return to Home feature *@
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg shadow-sm">
                                <i class="bi bi-send-fill me-2"></i>Submit Inquiry
                            </button>
                            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-house-door me-1"></i>Return to Homepage
                            </a>
                        </div>
                    </form>
                </div>

                <div class="card-footer bg-light text-center py-3">
                    <small class="text-muted">Register as a member for faster support and priority booking.</small>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
} 
