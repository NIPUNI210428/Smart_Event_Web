@using Smart_Event_Web.Models
@model IEnumerable<Event>

@{
    ViewData["Title"] = "Home - Smart Event Council";
}

@* Hero Section with Background Banner *@
<div class="p-5 mb-4 text-white rounded-3 shadow overflow-hidden"
     style="background: linear-gradient(rgba(0,0,0,0.65), rgba(0,0,0,0.65)), url('@Url.Content("~/images/posters/banner.jpg")');
            background-size: cover; background-position: center; min-height: 450px; display: flex; align-items: center;">

    <div class="container-fluid py-5 text-center">
        <h1 class="display-5 fw-bold">Metropolitan Cultural Council</h1>
        <p class="fs-5 mb-4">Supporting local arts through a modern cultural portal.</p>

        <div class="row justify-content-center g-3">
            <div class="col-md-4">
                <div class="card glass-card border-0 shadow">
                    <div class="card-body d-flex align-items-center justify-content-center">
                        @* FIXED: Changed asp-controller from "Account" to "Member" to match your MemberController.cs *@
                        <a asp-controller="Member" asp-action="Login" class="btn btn-custom-member w-100">Login as Member</a>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card glass-card border-0 shadow">
                    <div class="card-body d-flex align-items-center justify-content-center">
                        <a asp-controller="Event" asp-action="Index" class="btn btn-custom-guest w-100">Browse as Guest</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold mb-0">Upcoming Events</h2>
        @if (Context.Session.GetString("UserName") != null)
        {
            <span class="badge bg-success p-2">Welcome, @Context.Session.GetString("UserName")!</span>
        }
    </div>

    @* row-cols-md-3 ensures 3 cards per row, g-4 adds consistent spacing *@
    <div class="row row-cols-1 row-cols-md-3 g-4">
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <div class="col">
                    @* card h-100 forces all cards to stretch to the same height *@
                    <div class="card h-100 border-0 shadow-sm overflow-hidden d-flex flex-column">

                        @if (!string.IsNullOrEmpty(item.ImageFileName))
                        {
                            <img src="~/images/posters/@item.ImageFileName" class="card-img-top" alt="Event Image" style="height: 200px; object-fit: cover;">
                        }
                        else
                        {
                            <div class="bg-light text-muted text-center py-5" style="height: 200px;">
                                <i class="bi bi-image" style="font-size: 2rem;"></i><br>No Image
                            </div>
                        }

                        <div class="card-body d-flex flex-column">
                            <h5 class="fw-bold">@item.Event_Name</h5>

                            <p class="text-muted small mb-1">
                                <i class="bi bi-calendar-event"></i> @item.Event_Date
                            </p>
                            <p class="text-muted small mb-2">
                                <i class="bi bi-geo-alt"></i> @item.Venue
                            </p>

                            <span class="badge bg-info text-dark mb-2" style="width: fit-content;">@item.Category</span>

                            @* mt-auto pushes the status to the very bottom, keeping things aligned *@
                            <p class="small text-muted mt-auto mb-0">Status: <b>@item.Status</b></p>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <p class="text-muted">No upcoming events found at this time.</p>
            </div>
        }
    </div>
</div> 