@model Smart_Event_Web.Models.Inquiry

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 border p-4 shadow-sm bg-white rounded">
            <h3 class="text-center mb-4">Guest Inquiry Form</h3>
            <form asp-controller="Booking" asp-action="SendInquiry" method="post">
                <div class="mb-3">
                    <label class="form-label">Email Address</label>
                    <input type="email" name="Email" class="form-control" required placeholder="For our reply..." />
                </div>
                <div class="mb-3">
                    <label class="form-label">Subject</label>
                    <input type="text" name="Subject" class="form-control" required />
                </div>
                <div class="mb-3">
                    <label class="form-label">Your Message</label>
                    <textarea name="Message" class="form-control" rows="4" required></textarea>
                </div>
                <button type="submit" class="btn btn-dark w-100">Send Inquiry</button>
            </form>
        </div>
    </div>
</div> 