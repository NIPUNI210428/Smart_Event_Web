@model IEnumerable<Smart_Event_Web.Models.Review>

@{
    ViewData["Title"] = "Event Reviews";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark">User Feedback</h2>
            <p class="text-muted small">Reviews for Event ID: #@ViewBag.EventId</p>
        </div>
        <a asp-controller="Event" asp-action="Index" class="btn btn-outline-primary shadow-sm">
            <i class="bi bi-arrow-left"></i> Back to Events
        </a>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="card border-0 shadow-sm text-center py-5">
            <div class="card-body">
                <i class="bi bi-chat-quote text-muted display-1"></i>
                <h5 class="mt-3">No reviews yet</h5>
                <p class="text-muted">Be the first to share your experience for this event!</p>
            </div>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var review in Model)
            {
                <div class="col-12 mb-3">
                    <div class="card shadow-sm border-0 border-start border-warning border-5 h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    @* FIXED: Uses Member_id *@
                                    <span class="badge bg-light text-dark border mb-2">
                                        <i class="bi bi-person-circle text-primary"></i> Member #@review.Member_id
                                    </span>
                                    @* FIXED: Uses Comments *@
                                    <p class="fs-5 text-dark mb-1">"@review.Comments"</p>
                                </div>
                                <div class="text-warning">
                                    @for (int i = 0; i < review.Rating; i++)
                                    {
                                        <i class="bi bi-star-fill"></i>
                                    }
                                    @for (int i = review.Rating; i < 5; i++)
                                    {
                                        <i class="bi bi-star text-muted"></i>
                                    }
                                </div>
                            </div>
                            <div class="mt-2">
                                <small class="text-muted"><i class="bi bi-clock"></i> @review.Review_Date</small>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div> 