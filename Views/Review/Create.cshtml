@model Smart_Event_Web.Models.Review

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow border-0">
                <div class="card-header bg-primary text-white text-center py-3">
                    <h4 class="mb-0">Rate Your Experience</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        <input type="hidden" asp-for="Event_id" value="@ViewBag.EventId" />

                        <div class="mb-3">
                            <label asp-for="Member_id" class="form-label fw-bold">Member ID</label>
                            <input asp-for="Member_id" type="number" class="form-control" />
                            <span asp-validation-for="Member_id" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Rating" class="form-label fw-bold">Rating (1-5 Stars)</label>
                            <select asp-for="Rating" class="form-select">
                                <option value="5">⭐⭐⭐⭐⭐</option>
                                <option value="4">⭐⭐⭐⭐</option>
                                <option value="3">⭐⭐⭐</option>
                                <option value="2">⭐⭐</option>
                                <option value="1">⭐</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Comments" class="form-label fw-bold">Your Feedback</label>
                            <textarea asp-for="Comments" class="form-control" rows="4"></textarea>
                            <span asp-validation-for="Comments" class="text-danger small"></span>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg">Submit Review</button>
                            <a asp-controller="Event" asp-action="Index" class="btn btn-light">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div> 
